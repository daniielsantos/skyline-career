{
  "name": "@msfs-compat/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Skyline Career desktop shell (Electron)",
  "author": "Skyline Career",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "pack": "node ../../scripts/pack-desktop.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.skyline.career",
    "productName": "Skyline Career",
    "copyright": "Copyright © Skyline Career",
    "electronVersion": "35.7.5",
    "afterPack": "./afterPack.cjs",
    "directories": {
      "output": "../../artifacts/skyline-desktop",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "package.json",
      "build/icon.ico",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../../artifacts/skyline-runtime",
        "to": "skyline",
        "filter": ["**/*"]
      },
      {
        "from": "../../artifacts/skyline-host",
        "to": "host",
        "filter": ["**/*"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "daniielsantos",
        "repo": "skyline-career"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SkylineCareer-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skyline Career",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SkylineCareer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SkylineCareer-${version}-portable.exe"
    },
    "asar": true
  }
}
