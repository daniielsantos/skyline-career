        "writeVar": "FUEL TANK RIGHT MAIN QUANTITY",
        "writeUnit": "gallons"
      }
    ],
    "writePlan": [
      {
        "op": "simvar_set",
        "var": "FUEL TANK LEFT MAIN QUANTITY",
        "unit": "gallons",
        "valueExpr": "{LEFT_MAIN}"
      },
      {
        "op": "simvar_set",
        "var": "FUEL TANK RIGHT MAIN QUANTITY",
        "unit": "gallons",
        "valueExpr": "{RIGHT_MAIN}"
      }
    ],
    "verify": {
      "timeoutMs": 2500,
      "pollIntervalMs": 200,
      "checks": [
        {
          "var": "FUEL TOTAL QUANTITY",
          "unit": "gallons",
          "tolerancePct": 1,
          "valueExpr": "{LEFT_MAIN} + {RIGHT_MAIN}"
        }
      ]
    }
  },
