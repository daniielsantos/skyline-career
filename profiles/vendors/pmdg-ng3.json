  "publisher": "pmdg",
  "displayName": "PMDG 737 NG3 / NGXu family",
  "summary": "Fuel is owned by the PMDG SDK (Client Data PMDG_NG3_Data), not classic FUEL TANK writes and not Accu-Sim-style LVars. Payload stations often accept classic SimConnect writes. Skyline needs native Client Data support before fuel apply works.",
  "detectMode": "publisher_then_probes",
