{
  "name": "msfs-compat-layer",
  "version": "0.1.0",
  "private": true,
  "description": "Compatibility layer for MSFS fuel/payload control across aircraft addons",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @msfs-compat/shared && npm run build -w @msfs-compat/runtime && npm run build -w @msfs-compat/agent && npm run build -w @msfs-compat/catalog-api && npm run build -w @msfs-compat/career-ui",
    "build:native": "dotnet build native/SimBridgeHost/SimBridgeHost.csproj -c Release",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:profiles": "node scripts/validate-profiles.mjs",
    "fingerprints:backfill": "node scripts/backfill-fingerprints.mjs",
    "airframes:backfill-simbrief-cargo": "node --import tsx packages/agent/src/cli.ts career-airframe backfill-simbrief-cargo",
    "host:mock": "node packages/agent/dist/mock-host.js",
    "host:native": "dotnet run --project native/SimBridgeHost -c Release -- --mode mock",
    "host:simconnect": "dotnet run --project native/SimBridgeHost -c Release -- --mode simconnect --sdk \"C:\\MSFS 2024 SDK\"",
    "catalog:serve": "node scripts/start-local-stack.mjs",
    "catalog:serve:pg": "node scripts/start-catalog-pg.mjs",
    "catalog:start": "npm run start -w @msfs-compat/catalog-api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed-profiles.mjs",
    "start:local": "node scripts/start-skyline.mjs --mode simconnect",
    "start:local:mock": "node scripts/start-skyline.mjs --mode mock",
    "homologate": "node packages/agent/dist/cli.js homologate",
    "sample-burn": "node packages/agent/dist/cli.js sample-burn",
    "probe-lvars": "node packages/agent/dist/cli.js probe-lvars --preset a2a-aerostar",
    "probe-pmdg-fuel": "node packages/agent/dist/cli.js probe-pmdg-fuel",
    "scaffold-ofp-roles": "node packages/agent/dist/cli.js scaffold-ofp-roles",
    "draft-ofp-roles": "node packages/agent/dist/cli.js draft-ofp-roles",
    "probe-payload-stations": "node packages/agent/dist/cli.js probe-payload-stations",
    "pmdg-cdu": "node packages/agent/dist/cli.js pmdg-cdu",
    "compare-ofp": "node packages/agent/dist/cli.js compare-ofp",
    "generate-ofp": "node packages/agent/dist/cli.js generate-ofp",
    "monitor-ofp": "node packages/agent/dist/cli.js monitor-ofp",
    "career": "node packages/agent/dist/cli.js career",
    "career-airframe": "node packages/agent/dist/cli.js career-airframe",
    "career-payload": "node packages/agent/dist/cli.js career-payload",
    "career-hubs": "node packages/agent/dist/cli.js career-hubs",
    "career:ui": "npm run dev -w @msfs-compat/career-ui",
    "test:shared": "npm run test -w @msfs-compat/shared",
    "test:agent": "npm run test -w @msfs-compat/agent",
    "test:career-ui": "npm run test -w @msfs-compat/career-ui",
    "pack:portable": "node scripts/pack-portable.mjs",
    "pack:desktop": "node scripts/pack-desktop.mjs",
    "release:desktop": "node scripts/release-desktop.mjs",
    "smoke": "node scripts/smoke.mjs",
    "ci:catalog": "node scripts/ci-catalog.mjs",
    "ci": "npm run build && npm run typecheck && npm run validate:profiles && npm run ci:catalog",
    "resolve": "node packages/agent/dist/cli.js resolve",
    "apply-auto": "node packages/agent/dist/cli.js apply-auto"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
