# Local Skyline Career environment (copy to `.env` — gitignored).
# Never commit real passwords or MAPTILER_KEY.

# --- Postgres / Docker compose (career stack) ---
# Compose reads these for postgres + world-api + world-worker.
# Defaults in docker-compose.yml stay skyline/skyline if unset (lab only).
# Changing POSTGRES_PASSWORD after the volume already exists does NOT rotate
# the DB password — alter role or recreate the volume.
POSTGRES_USER=skyline
POSTGRES_PASSWORD=skyline
POSTGRES_DB=skyline
# Docker network hostname is `postgres` (not 127.0.0.1). Must match POSTGRES_*.
CAREER_DATABASE_URL=postgres://skyline:skyline@postgres:5432/skyline
# Host-side Node / DBeaver (lab overlay publishes loopback):
# CAREER_DATABASE_URL=postgres://skyline:skyline@127.0.0.1:5432/skyline
#
# Stack: npm run db:up | career:stack:world          → lab (127.0.0.1:5432 + Adminer)
#        npm run career:stack:world -- --prod        → VPS (no DB ports; API loopback)
#        npm run career:stack:world -- --prod --tls  → + Caddy HTTPS (Let's Encrypt)
# CAREER_WORLD_HOST=world.example.com
# (legacy alias still accepted: SKYLINE_WORLD_HOST)
#
# Production/staging consume the immutable GHCR digest written by the deploy
# workflow to `.env.deploy`. Set this manually only for an explicit rollback.
# CAREER_WORLD_IMAGE=ghcr.io/daniielsantos/skyline-career-world@sha256:...
#
# Production fail-closed: the prod overlay defaults this to 0, so an empty or
# wrong Postgres DB stops instead of silently creating a replacement world.
# For the very first empty bootstrap only: set 1, wait for a healthy seeded
# world, then return to 0 and recreate world-api/world-worker.
CAREER_WORLD_ALLOW_SEED=0

# Catalog (file mode is default when unset)
DATABASE_URL=postgres://skyline:skyline@localhost:5432/skyline
CATALOG_SIGNING_KEY=dev-local-key
PORT=8080
MSFS_COMPAT_CATALOG_URL=http://localhost:8080/v1
MSFS_SDK=C:\MSFS 2024 SDK

# MapTiler (Airport tab satellite). Uncommented key in gitignored `.env`:
MAPTILER_KEY=
# Docker world-api also reads MAPTILER_KEY from this file (recreate container after change).

# --- Auth registration policy ---
# Lab stays open when both values are unset. For a private production beta,
# keep registration enabled and set a long random invite code:
CAREER_AUTH_REGISTER=1
CAREER_AUTH_INVITE=
# Alternative: close all new registrations (existing users can still login):
# CAREER_AUTH_REGISTER=0
#
# Unsafe/admin-style capabilities stay disabled in production.
CAREER_AUTH_ALLOW_CLAIM=0
CAREER_AUTH_SESSIONS_LIST_ALL=0
