# World host + worker image (no SimBridge). Desktop owns Watch.
# Prefer host-built shared dist for faster/reliable local builds.
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/agent/package.json ./packages/agent/package.json
COPY packages/career-ui/package.json ./packages/career-ui/package.json
COPY packages/catalog-api/package.json ./packages/catalog-api/package.json
COPY packages/desktop/package.json ./packages/desktop/package.json
COPY packages/runtime/package.json ./packages/runtime/package.json
COPY packages/shared/package.json ./packages/shared/package.json

RUN npm ci

COPY tsconfig.base.json ./
COPY packages ./packages
COPY scripts ./scripts
COPY profiles/career ./profiles/career

RUN npm run build -w @msfs-compat/shared \
    && npm run build -w @msfs-compat/runtime

ENV CAREER_API_MODE=world \
    CAREER_DISABLE_SIM=1 \
    CAREER_AUTH=1 \
    CAREER_WORLD_FIXED=1 \
    CAREER_HEADLESS_PULSE=0 \
    CAREER_PG=1 \
    CAREER_UI_API_BIND=0.0.0.0 \
    CAREER_UI_API_PORT=8787 \
    SKYLINE_CAREER_DATA=/data/career \
    SKYLINE_CAREER_CONTENT=/app/profiles/career

RUN mkdir -p /data/career/world

EXPOSE 8787
CMD ["node", "--import", "tsx", "packages/career-ui/server/api.ts"]
