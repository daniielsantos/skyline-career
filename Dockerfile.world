# World host + worker image (no SimBridge). Desktop owns Watch.
# The builder can be large; only the minimal runtime stage is published.
FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/agent/package.json ./packages/agent/package.json
COPY packages/career-ui/package.json ./packages/career-ui/package.json
COPY packages/catalog-api/package.json ./packages/catalog-api/package.json
COPY packages/desktop/package.json ./packages/desktop/package.json
COPY packages/runtime/package.json ./packages/runtime/package.json
COPY packages/shared/package.json ./packages/shared/package.json

RUN npm ci

COPY tsconfig.base.json ./
COPY packages ./packages
COPY scripts ./scripts
COPY profiles/career ./profiles/career

RUN npm run build -w @msfs-compat/shared \
    && npm run build -w @msfs-compat/runtime

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

COPY deploy/world-runtime/package.json deploy/world-runtime/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/runtime/package.json ./packages/runtime/package.json
COPY --from=builder /app/packages/runtime/dist ./packages/runtime/dist
COPY --from=builder /app/packages/agent/package.json ./packages/agent/package.json
COPY --from=builder /app/packages/agent/src ./packages/agent/src
COPY --from=builder /app/packages/career-ui/package.json ./packages/career-ui/package.json
COPY --from=builder /app/packages/career-ui/server ./packages/career-ui/server
COPY --from=builder /app/scripts/career-world-worker-pg.mjs ./scripts/career-world-worker-pg.mjs
COPY --from=builder /app/profiles/career ./profiles/career

RUN mkdir -p node_modules/@msfs-compat /data/career/world \
    && ln -s /app/packages/shared node_modules/@msfs-compat/shared \
    && ln -s /app/packages/runtime node_modules/@msfs-compat/runtime

ENV CAREER_API_MODE=world \
    CAREER_DISABLE_SIM=1 \
    CAREER_AUTH=1 \
    CAREER_WORLD_FIXED=1 \
    CAREER_HEADLESS_PULSE=0 \
    CAREER_PG=1 \
    CAREER_UI_API_BIND=0.0.0.0 \
    CAREER_UI_API_PORT=8787 \
    SKYLINE_CAREER_DATA=/data/career \
    SKYLINE_CAREER_CONTENT=/app/profiles/career

EXPOSE 8787
CMD ["node", "--import", "tsx", "packages/career-ui/server/api.ts"]
