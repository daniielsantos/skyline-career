    { "kind": "publisher", "value": "pmdg" },
    { "kind": "title_regex", "value": "\\b(pmdg|737-?8|b738|ng3)\\b" },
    { "kind": "classic_writetest_fails" }
  ],
  "capabilities": ["simconnect"],
  "fuel": {
    "strategy": "vendor-specific",
    "preferUsableCapacity": false,
    "tanks": [
      {
        "id": "LEFT_MAIN",
        "label": "Left wing (SDK QtyLeft)",
        "readSimVar": "FUEL TANK LEFT MAIN QUANTITY",
        "capacitySimVar": "FUEL TANK LEFT MAIN CAPACITY"
      },
      {
        "id": "RIGHT_MAIN",
        "label": "Right wing (SDK QtyRight)",
        "readSimVar": "FUEL TANK RIGHT MAIN QUANTITY",
        "capacitySimVar": "FUEL TANK RIGHT MAIN CAPACITY"
      },
      {
        "id": "CENTER",
        "label": "Center (SDK QtyCenter)",
        "readSimVar": "FUEL TANK CENTER QUANTITY",
        "capacitySimVar": "FUEL TANK CENTER CAPACITY"
      }
    ],
    "probeLVars": []
  },
  "payload": {
    "strategy": "station-writeback"
  },
  "wizard": {
    "onClassicWriteFail": "abort",
    "notesTemplate": "pmdg-ng3"
  },
