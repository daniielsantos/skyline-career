    "maxSimRate": 1.1
  },
  "fuel": {
    "strategy": "simconnect-direct",
    "unit": "gallons",
    "tanks": [
      {
        "id": "LEFT_MAIN",
        "name": "Left Main",
        "capacity": 26,
        "readVar": "FUEL TANK LEFT MAIN QUANTITY",
        "readUnit": "gallons",
        "writeVar": "FUEL TANK LEFT MAIN QUANTITY",
        "writeUnit": "gallons"
      },
      {
        "id": "RIGHT_MAIN",
        "name": "Right Main",
        "capacity": 26,
        "readVar": "FUEL TANK RIGHT MAIN QUANTITY",
