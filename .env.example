# Local Skyline Career environment (copy to `.env` — gitignored).
# Never commit real passwords or MAPTILER_KEY.

# --- Postgres / Docker compose (career stack) ---
# Compose reads these for postgres + world-api + world-worker.
# Defaults in docker-compose.yml stay skyline/skyline if unset (lab only).
# Changing POSTGRES_PASSWORD after the volume already exists does NOT rotate
# the DB password — alter role or recreate the volume.
POSTGRES_USER=skyline
POSTGRES_PASSWORD=skyline
POSTGRES_DB=skyline
# Docker network hostname is `postgres` (not 127.0.0.1). Must match POSTGRES_*.
CAREER_DATABASE_URL=postgres://skyline:skyline@postgres:5432/skyline
# Host-side Node / DBeaver (lab overlay publishes loopback):
# CAREER_DATABASE_URL=postgres://skyline:skyline@127.0.0.1:5432/skyline
#
# Stack: npm run db:up | career:stack:world          → lab (127.0.0.1:5432 + Adminer)
#        npm run career:stack:world -- --prod        → VPS (no DB ports)

# Catalog (file mode is default when unset)
DATABASE_URL=postgres://skyline:skyline@localhost:5432/skyline
CATALOG_SIGNING_KEY=dev-local-key
PORT=8080
MSFS_COMPAT_CATALOG_URL=http://localhost:8080/v1
MSFS_SDK=C:\MSFS 2024 SDK

# MapTiler (Airport tab satellite). Uncommented key in gitignored `.env`:
MAPTILER_KEY=
# Docker world-api also reads MAPTILER_KEY from this file (recreate container after change).

# --- Auth harden (optional; lab defaults stay open) ---
# CAREER_AUTH_REGISTER=0
# CAREER_AUTH_INVITE=your-shared-code
# CAREER_AUTH_ALLOW_CLAIM=1
# CAREER_AUTH_SESSIONS_LIST_ALL=1
